# Copy to .env and fill in the keys.

# --- LLM (https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Datastores (defaults match docker-compose) ---
DATABASE_URL=postgresql+asyncpg://vocal:vocal@localhost:5432/vocal
QDRANT_URL=http://localhost:6333

# --- ElevenLabs Conversational AI (https://elevenlabs.io/app/settings/api-keys) ---
ELEVENLABS_API_KEY=
# Filled in after running `make elevenlabs-agent`
ELEVENLABS_AGENT_ID=
# From ElevenLabs > Settings > Webhooks (post-call webhook HMAC secret)
ELEVENLABS_WEBHOOK_SECRET=
# Optional: any ElevenLabs voice ID (default: Sarah)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Shared secret ElevenLabs uses to call our custom LLM endpoint. Generate with: openssl rand -hex 32
CUSTOM_LLM_API_KEY=

# Public HTTPS URL of the backend (e.g. your ngrok URL: https://abc123.ngrok-free.app)
PUBLIC_BACKEND_URL=

# Optional: your own phone number (E.164, e.g. +9477xxxxxxx) so calls from it are
# recognised as the demo customer "Priya Sharma" when you run `make seed`.
DEMO_CUSTOMER_PHONE=
